generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- Kullanıcı Rolleri (RBAC) --
enum Role {
  SUPER_ADMIN
  EDITOR
  SUPPORT
}

model Admin {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  passwordHash String
  role         Role          @default(SUPER_ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  priceLogs    PriceLog[]
  activityLogs ActivityLog[]
}

// -- Kurumsal Kategori Sistemi --
model Category {
  id              Int        @id @default(autoincrement())
  name            String
  slug            String     @unique
  description     String?
  imageUrl        String?
  attributes      String?    // JSON definition of attributes: ["Brand", "CPU"]
  parentId        Int?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  products        Product[]
  
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  order           Int        @default(0)
}

// -- Akıllı Döviz Endeksli Ürün --
model Product {
  id              Int            @id @default(autoincrement())
  title           String
  description     String
  
  // Sabit Gösterge Fiyatı
  price           Decimal
  
  // Forex Fiyatlandırma Sistemi
  basePrice       Decimal?       // Yabancı veya Ana Para Birimi (Örn: 1000)
  currency        String         @default("TRY") // TRY, USD, EUR
  exchangeRateUsed Decimal?      // O Fiyat belirlenirkenki güncel kur (Örn: 34.50)
  
  categoryId      Int
  category        Category       @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  attributes      String?        // JSON values: {"Brand": "Asus", "CPU": "i5"}
  status          String         @default("On Sale") // On Sale, Sold
  stock           Int            @default(0)
  originalPrice   Decimal?
  discountEndDate DateTime?
  isDeal          Boolean        @default(false)
  
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  priceLogs       PriceLog[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// -- Fiyat Değişim Logları --
model PriceLog {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice    Decimal
  newPrice    Decimal
  currency    String   @default("TRY")
  reason      String
  adminId     Int?     // Who changed it (null if system auto-update)
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// -- Aktivite Denetim Logları (Audit Trails) --
model ActivityLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String   // Örn: "Ürün Silindi", "Giriş Yapıldı"
  details     String?  // JSON string: ne değiştirildi?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// Elektronik Finans Başvuruları
model FinanceRequest {
  id             Int      @id @default(autoincrement())
  fullName       String
  phone          String
  email          String?
  deviceType     String
  brandModel     String
  deviceCondition String?
  requestedAmount Decimal?
  message        String?
  images         String[]
  status         String   @default("Beklemede") // Beklemede, İnceleniyor, Onaylandı, Reddedildi
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RepairRequest {
  id             Int      @id @default(autoincrement())
  fullName       String
  phone          String
  email          String?
  deviceType     String
  brandModel     String
  problemDescription String
  mediaUrl       String?  // External video link
  images         String[] // Uploaded photo URLs
  status         String   @default("Beklemede")
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SecondHandListing {
  id             Int      @id @default(autoincrement())
  personalInfo   String   // JSON: { name, surname, phone, email }
  productInfo    String   // JSON: { brand, model, description, estimatedPrice }
  condition      String   // SIFIR_GIBI, COK_IYI, IYI, ORTA
  accessories    String?  // JSON array: ["Kutu", "Fatura"]
  images         String   // JSON array of URLs
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, ARCHIVED
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -- Sistem Kuralları ve Dinamik Site Ayarları --
model SiteSettings {
  id                 Int      @id @default(autoincrement())
  siteName           String   @default("Wolf Bilişim Premium")
  description        String?  @default("Kurumsal Teknoloji Çözüm Ortağınız")
  contactEmail       String?
  contactPhone       String?
  address            String?
  socialMedia        String?  // JSON: { instagram, facebook, twitter, youtube, tiktok }
  
  maintenanceMode    Boolean  @default(false)
  announcementActive Boolean  @default(false)
  announcementText   String?  // Örn: "Kurumsal Mac alımlarında anında kredi fırsatı!"
  
  exchangeThreshold  Decimal  @default(10.0) // Kritik: %10 değişim olmadığı sürece fiyat değişmez
  
  updatedAt          DateTime @updatedAt
}
