import Link from "next/link";
import { ShoppingCart } from "lucide-react";

interface ProductCardProps {
    product: {
        id: number;
        title: string;
        price: number;
        images: { url: string; isMain: boolean }[];
        category: { name: string };
        status: string;
    };
}

export default function ProductCard({ product }: ProductCardProps) {
    const isSold = product.status === "Sold" || product.status === "Satıldı";
    const mainImage = product.images.find(img => img.isMain)?.url || product.images[0]?.url;

    if (isSold) {
        return (
            <div className="group bg-white/5 border border-white/10 rounded-xl overflow-hidden flex flex-col opacity-75">
                <div className="relative aspect-square overflow-hidden bg-black/20">
                    {mainImage ? (
                        <img
                            src={mainImage}
                            alt={product.title}
                            className="w-full h-full object-cover grayscale"
                        />
                    ) : (
                        <div className="w-full h-full flex items-center justify-center text-gray-500">
                            Görsel Yok
                        </div>
                    )}
                    <div className="absolute top-3 right-3 z-10">
                        <span className="bg-red-600 text-white text-sm font-extrabold px-4 py-2 rounded-full shadow-[0_0_20px_rgba(220,38,38,0.6)] block uppercase tracking-wide">
                            Satıldı
                        </span>
                    </div>
                </div>

                <div className="p-4 flex-grow flex flex-col">
                    <div className="text-xs text-gray-500 mb-1">{product.category.name}</div>
                    <h3 className="text-lg font-semibold mb-2 line-clamp-2 text-gray-500">
                        {product.title}
                    </h3>
                    <div className="mt-auto flex items-center justify-between">
                        <span className="text-xl font-bold text-gray-500 line-through decoration-red-500/50">
                            ₺{Number(product.price).toLocaleString()}
                        </span>
                    </div>
                </div>
            </div>
        );
    }

    return (
        <Link
            href={`/products/${product.id}`}
            className="group bg-white/5 border border-white/10 rounded-xl overflow-hidden hover:border-blue-500/50 transition-all hover:shadow-lg hover:shadow-blue-500/10 flex flex-col"
        >
            <div className="relative aspect-square overflow-hidden bg-black/20">
                {mainImage ? (
                    <img
                        src={mainImage}
                        alt={product.title}
                        className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                ) : (
                    <div className="w-full h-full flex items-center justify-center text-gray-500">
                        Görsel Yok
                    </div>
                )}
                <div className="absolute top-3 right-3 z-10">
                    <span className="bg-green-500/90 text-black text-sm font-extrabold px-4 py-2 rounded-full shadow-[0_0_15px_rgba(34,197,94,0.4)] border border-green-400/50 uppercase tracking-wide backdrop-blur-md">
                        Satışta
                    </span>
                </div>
            </div>

            <div className="p-4 flex-grow flex flex-col">
                <div className="text-xs text-blue-400 mb-1">{product.category.name}</div>
                <h3 className="text-lg font-semibold mb-2 line-clamp-2 transition-colors group-hover:text-blue-400">
                    {product.title}
                </h3>
                <div className="mt-auto flex items-center justify-between">
                    <span className="text-xl font-bold text-white">
                        ₺{Number(product.price).toLocaleString()}
                    </span>
                    <button className="p-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-white">
                        <ShoppingCart className="w-4 h-4" />
                    </button>
                </div>
            </div>
        </Link>
    );
}
